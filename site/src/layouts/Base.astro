---
import '../styles/global.css';
import '../styles/p1-reading-flow.css';
import '../styles/haloflux-editorial.css';
import { BASE, allDocs } from '../lib/catalog.mjs';
const { title = '研究觀測所', description = 'Research-｜可追溯的技術研究資料庫', artDirection = null } = Astro.props;
const editorial = ['library','search','domain','article'].includes(artDirection);
const recordCount = editorial ? allDocs().length : null;
---
<!doctype html>
<html lang="zh-Hant-TW" data-art-direction={editorial ? "haloflux" : undefined}>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content={description}/>
  <meta name="color-scheme" content="dark"/>
  <title>{title} · THE OBSERVATORY</title>
  {editorial && <link rel="stylesheet" href="/Research-/v3/haloflux-site/immersive.css" />}
</head>
<body class:list={[editorial && "research-inner", editorial && `research-inner-${artDirection}`]}>
  <a class="skip" href="#main">直接前往正文</a>
  {editorial && <div class="hfx-field" aria-hidden="true"><iframe src="/Research-/v3/haloflux-site/field.html" title="HALOFLUX 光場" loading="lazy" tabindex="-1" aria-hidden="true"></iframe></div>}
  <header class="global-header">
    <a class="brand" href="/Research-/" aria-label="RESEARCH— THE OBSERVATORY｜返回天文觀測神殿首頁">
      <span class="brand-mark" aria-hidden="true">✦</span>
      <span class="brand-type">RESEARCH—<small>THE OBSERVATORY</small></span>
    </a>
    <nav aria-label="全站導覽">
      <a href="/Research-/">觀測神殿</a>
      <a href={BASE + 'library/'}>研究分類</a>
      <a href={BASE + 'search/'}>全文搜尋</a>
      {editorial && <a href={BASE + 'haloflux-research/'} aria-label="光場介面｜HALOFLUX 整合研究光場"><span class="nav-full">光場介面</span><span class="nav-compact" aria-hidden="true">光場</span></a>}
    </nav>
    {editorial && <a class="research-masthead-status" href={BASE + "library/"}><span>研究典藏 / INDEX</span><strong>{recordCount}</strong></a>}
  </header>
  {editorial && <a class="mobile-lightfield-link" href={BASE + "haloflux-research/"}><span>HALOFLUX / FIELD</span><strong>開啟光場介面 <span aria-hidden="true">↗</span></strong></a>}
  <main id="main"><slot /></main>
  <footer class="global-footer">
    <span>RESEARCH / VERIFIED SOURCES / OPEN QUESTIONS</span>
    <span>研究觀測神殿 · 技術資料庫 · 來源可追溯</span>
  </footer>
  {editorial && <div class="hfx-source-credit">動態視覺原始碼：<a href="https://github.com/Ryder191/haloflux" rel="noopener noreferrer">HALOFLUX by Ryder191</a> · PolyForm Noncommercial 1.0.0 · <a href={BASE+"haloflux/"}>檢視原作</a></div>}
  {editorial && <script defer src="/Research-/v3/haloflux-site/immersive.js"></script>}
</body>
</html>
