---
import '../styles/global.css';
import '../styles/p1-reading-flow.css';
import '../styles/haloflux-reading.css';
import { BASE } from '../lib/catalog.mjs';
const pathname = Astro.url.pathname;
const isLibrary = pathname.includes('/library/') || pathname.includes('/domains/');
const isSearch = pathname.includes('/search/');
const { title = '研究觀測所', description = 'Research-｜可追溯的技術研究資料庫' } = Astro.props;
---
<!doctype html>
<html lang="zh-TW">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content={description}/>
  <meta name="color-scheme" content="dark"/>
  <title>{title} · THE OBSERVATORY</title>
</head>
<body>
  <canvas class="halo-stage reader-halo" aria-hidden="true"></canvas>
  <script is:inline defer src="/Research-/v3/atlas/sanctum/haloflux-observatory.js"></script>
  <a class="skip" href="#main">直接前往正文</a>
  <header class="global-header">
    <a class="brand" href="/Research-/" aria-label="RESEARCH— THE OBSERVATORY｜返回天文觀測神殿首頁">
      <span class="brand-mark" aria-hidden="true">✦</span>
      <span class="brand-type">RESEARCH—<small>THE OBSERVATORY</small></span>
    </a>
    <nav aria-label="全站導覽">
      <a href="/Research-/">觀測神殿</a>
      <a href={BASE + 'library/'} aria-current={isLibrary ? 'page' : undefined}>研究分類</a>
      <a href={BASE + 'search/'} aria-current={isSearch ? 'page' : undefined}>全文搜尋</a>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="global-footer">
    <span>RESEARCH / VERIFIED SOURCES / OPEN QUESTIONS</span>
    <span>研究觀測神殿 · 技術資料庫 · 來源可追溯</span>
    <span>視覺效果改編自 <a href="https://github.com/Ryder191/haloflux">HALOFLUX by Ryder191</a> · <a href="/Research-/v3/atlas/sanctum/HALOFLUX-LICENSE.txt">非商用授權</a></span>
  </footer>
</body>
</html>
