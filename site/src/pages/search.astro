---
import Base from '../layouts/Base.astro';
import {allDocs,domains,displayDomain} from '../lib/catalog.mjs';
import {topicsFor,tagsFor} from '../lib/research-metadata.mjs';
const docs=allDocs(),topics=topicsFor(docs),tags=tagsFor(docs);
---
<Base title="全文搜尋｜研究觀測所" artDirection="search">
  <section class="search-page">
    <p class="eyebrow">RESEARCH / DISCOVERY</p>
    <h1>搜尋整座研究館。</h1>
    <p>公開閱讀頁面搜尋優先顯示已編輯技術正文。若要查找保留的歷史 Markdown（包含過去的 PR、方案及未驗證主張），請切換至「歷史原始研究」；兩種結果不會混為一談。</p>
    <form id="search-form" role="search" autocomplete="off">
      <fieldset class="search-scope"><legend>搜尋範圍</legend><label><input type="radio" name="search-scope" value="public" checked/> 公開閱讀頁面</label><label><input type="radio" name="search-scope" value="original"/> 歷史原始研究（全文；未重新查證）</label></fieldset>
      <label for="search-term">研究關鍵字</label>
      <div class="search-controls"><input id="search-term" type="search" placeholder="例如：WebGPU、Agent、海洋、效能……"/><button type="submit">搜尋</button></div>
      <div class="search-facet-grid">
        <label for="domain-filter">研究領域<select id="domain-filter"><option value="">全部領域</option>{domains().map(d=><option value={d}>{displayDomain(d)}</option>)}</select></label>
        <label for="topic-filter">細分主題<select id="topic-filter"><option value="">全部主題</option>{topics.map(t=><option value={t}>{t}</option>)}</select></label>
        <label for="tag-filter">技術標籤<select id="tag-filter"><option value="">全部技術</option>{tags.map(t=><option value={t}>{t}</option>)}</select></label>
      </div>
    </form>
    <p class="search-shortcut">不知道關鍵字？也可以直接選分類後按搜尋，或前往 <a href="/Research-/v3/library/">研究典藏索引</a>。</p>
    <div id="search-feedback" role="status" aria-live="polite"></div>
    <ol id="search-results" class="document-list research-search-results" aria-label="搜尋結果"></ol>
    <button id="search-load-more" class="search-more" type="button" hidden>載入更多研究</button>
    <section id="search-fallback">
      <h2>所有研究文件</h2>
      <p class="muted">如果停用了 JavaScript，仍可以透過下方連結打開完整文章。</p>
      <ol class="document-list">{docs.map(d=><li><a href={d.href}><span class="doc-row-copy"><strong>{d.publicTitle}</strong><small>{displayDomain(d.group)} · {d.topic}</small></span></a></li>)}</ol>
    </section>
  </section>
  <script is:inline type="module">
    const base='/Research-/v3/';
    const form=document.getElementById('search-form');
    const input=document.getElementById('search-term');
    const scopes=[...document.querySelectorAll('input[name="search-scope"]')];
    const selectedScope=()=>scopes.find(r=>r.checked)?.value||'public';
    const domain=document.getElementById('domain-filter');
    const topic=document.getElementById('topic-filter');
    const tag=document.getElementById('tag-filter');
    const feedback=document.getElementById('search-feedback');
    const list=document.getElementById('search-results');
    const loadMore=document.getElementById('search-load-more');
    const PAGE_SIZE=25;
    let matches=[],shown=0,serial=0,loading=false;
    let searchApi,originalDocs;
    const norm=value=>String(value||'').normalize('NFKC').toLocaleLowerCase('zh-TW');
    async function loadOriginalDocs(){
      if(originalDocs)return originalDocs;
      const response=await fetch(base+'original-search-index.json');
      if(!response.ok)throw new Error('原文索引無法載入');
      const index=await response.json();
      if(index.scope!=='archived-original-markdown'||!Array.isArray(index.documents))throw new Error('原文索引格式錯誤');
      originalDocs=index.documents;
      return originalDocs;
    }
    function snippet(doc,terms){
      const text=String(doc.text||'').replace(/[\r\n\t]+/g,' ').replace(/[#*`>\[\]]/g,' ').replace(/\s+/g,' ').trim();
      const at=terms.length?norm(text).indexOf(terms[0]):-1;
      const start=Math.max(0,at<0?0:at-45);
      return (start?'…':'')+text.slice(start,start+160)+(text.length>start+160?'…':'');
    }
    try{
      searchApi=await import(base+'pagefind/pagefind.js');
      await searchApi.options({baseUrl:base});
      document.getElementById('search-fallback').hidden=true;
      feedback.textContent='輸入關鍵字或選擇分類，開始搜尋全文。';
    }catch{
      feedback.textContent='全文搜尋尚未就緒，請使用下方完整研究目錄。';
    }
    const params=new URLSearchParams(location.search);
    if(params.get('q'))input.value=params.get('q');
    if(params.get('scope')==='original')scopes.find(r=>r.value==='original').checked=true;
    for(const [field,key] of [[domain,'domain'],[topic,'topic'],[tag,'tag']]){
      if(params.has(key)&&[...field.options].some(option=>option.value===params.get(key)))field.value=params.get(key);
    }
    async function appendNextPage(){
      if(loading||shown>=matches.length)return;
      loading=true;loadMore.disabled=true;
      const current=serial,chunk=matches.slice(shown,shown+PAGE_SIZE);
      try{
        // Pagefind provides all result refs, but loads details only for this page.
        const results=await Promise.all(chunk.map(result=>result.data()));
        if(current!==serial)return;
        for(const r of results){
          const li=document.createElement('li');
          const a=document.createElement('a');
          a.href=r.url;
          const copy=document.createElement('span');
          copy.className='doc-row-copy';
          const title=document.createElement('strong');
          title.textContent=r.meta?.title||r.url;
          const summary=document.createElement('span');
          summary.textContent=(r.plain_excerpt||r.excerpt||'').replace(/<[^>]*>/g,'').slice(0,175);
          const detail=document.createElement('small');
          detail.textContent=r.originalFile?'歷史原始研究｜未重新查證｜'+r.originalFile+'｜'+(r.originalDate||'日期未知'):'查看研究原文與來源 ↗';
          copy.append(title,summary,detail);
          a.append(copy);li.append(a);list.append(li);
        }
        shown+=results.length;
        loadMore.hidden=shown>=matches.length;
        feedback.textContent='找到 '+matches.length+' 項結果（已顯示 '+shown+' 項）。';
      }catch{
        if(current!==serial)return;
        feedback.textContent='載入下一批研究失敗，請再試一次。已顯示 '+shown+' 項。';
      }finally{
        if(current===serial){loading=false;loadMore.disabled=false;}
      }
    }
    async function search(event){
      if(event)event.preventDefault();
      if(!searchApi&&selectedScope()!=='original')return;
      const current=++serial;
      matches=[];shown=0;loading=false;
      loadMore.hidden=true;loadMore.disabled=false;
      const query=input.value.trim(),filters={};
      if(domain.value)filters.domain=domain.value;
      if(topic.value)filters.topic=topic.value;
      if(tag.value)filters.tag=tag.value;
      list.replaceChildren();
      if(!query&&!Object.keys(filters).length){feedback.textContent='請輸入關鍵字或選擇至少一個分類。';return}
      feedback.textContent='搜尋中……';
      try{
        if(selectedScope()==='original'){
          const docs=await loadOriginalDocs();
          if(current!==serial)return;
          document.getElementById('search-fallback').hidden=true;
          const terms=norm(query).split(/\s+/).filter(Boolean);
          const found=docs.filter(doc=>{
            if(filters.domain&&doc.group!==filters.domain)return false;
            if(filters.topic&&doc.topic!==filters.topic)return false;
            if(filters.tag&&!doc.tags.includes(filters.tag))return false;
            const text=norm(doc.title+' '+doc.publicTitle+' '+doc.text);
            return terms.every(term=>text.includes(term));
          });
          matches=found.map(doc=>({data:async()=>({
            url:doc.href,meta:{title:doc.publicTitle},
            plain_excerpt:snippet(doc,terms),originalFile:doc.file,originalDate:doc.date
          })}));
        }else{
          const response=await searchApi.search(query||null,{filters});
          if(current!==serial)return;
          matches=response.results;
        }
        if(!matches.length){
          feedback.textContent='找到 0 項結果。可修改關鍵字或移除篩選條件。';
          return;
        }
        await appendNextPage();
      }catch{
        if(current!==serial)return;
        feedback.textContent='搜尋發生錯誤，請使用完整研究目錄。';
        document.getElementById('search-fallback').hidden=false;
      }
    }
    loadMore.addEventListener('click',appendNextPage);
    form.addEventListener('submit',search);
    scopes.forEach(r=>r.addEventListener('change',()=>{
      if(input.value.trim()||domain.value||topic.value||tag.value)search();
      else feedback.textContent=r.value==='original'?'歷史原文可能含過期資訊；請輸入關鍵字或選擇分類。':'輸入關鍵字或選擇分類，搜尋公開閱讀頁面。';
    }));
    if(input.value||domain.value||topic.value||tag.value)search();
  </script>
  <style>
    .search-scope{display:flex;align-items:center;flex-wrap:wrap;gap:.65rem 1.25rem;border:1px solid var(--line);padding:.8rem 1rem;margin:0 0 1rem;border-radius:.65rem}
    .search-scope legend{padding:0 .4rem;color:var(--ink);font-weight:600}
    .search-scope label{display:inline-flex;gap:.5rem;align-items:center;line-height:1.6;cursor:pointer}
    .search-scope input{accent-color:var(--gold);width:1.05rem;height:1.05rem}
  </style>
</Base>
