---
import Atlas from '../../layouts/Atlas.astro';
import SceneArt from '../../components/atlas/SceneArt.astro';
import { concepts, getConcept } from '../../lib/atlas-concepts.mjs';
import { allDocs, BASE, domains, displayDomain, domainDocs } from '../../lib/catalog.mjs';
export function getStaticPaths() {
  return concepts.map(c => ({ params: { concept: c.slug }, props: { slug: c.slug } }));
}
const concept = getConcept(Astro.props.slug);
if (!concept) throw new Error('Unknown concept');
const docs = allDocs();
const doc = docs.find(d => d.file.endsWith('01-framework-selection.md')) ?? docs[0];
const sourceExcerpt = doc.text.split('\n').map(s => s.trim()).find(s => s.length > 55 && !/^[#>|*-]/.test(s))?.replace(/[*_]/g,'').slice(0,168) ?? doc.title;
const sampleDomains = domains().slice(0,4);
const sampleDocs = docs.filter(d => /README\.md$/.test(d.file)).slice(0,3);
const articleHeadings = doc.text.split('\n').filter(line => /^##\s+/.test(line)).slice(0,3).map(line => line.replace(/^##\s+/,''));
---
<Atlas title={concept.title + '｜互動網頁構圖研究'}>
<div class={'atlas-concept '+concept.slug}>
  <header class="atlas-case-heading">
    <div><p class="atlas-overline">INTERACTIVE WEB / COMPOSITION {concept.code}</p><h1>{concept.title}</h1><p class="atlas-case-en">{concept.subtitle}</p></div>
    <div class="atlas-case-meta"><p>{concept.description}</p><strong>{concept.principle}</strong></div>
  </header>
  <nav class="atlas-case-nav" aria-label="本方案預覽畫面"><a href="#home-scene">01 首頁</a><a href="#article-scene">02 文章閱讀</a><a href="#search-scene">03 搜尋與探索</a></nav>
  <section class="atlas-presentation" id="home-scene" data-scene="home" aria-label={concept.title + ' 首頁原型'}>
    <div class="atlas-frame-top"><span>01 / HOME</span><span>STATIC DESIGN STUDY · DESKTOP + MOBILE</span></div>
    <div class="atlas-prototype atlas-prototype-home">
      <div class="atlas-prototype-header"><a href={BASE + 'atlas/'} class="atlas-mini-brand">✧ <span>RESEARCH—<small>THE OBSERVATORY</small></span></a><span class="atlas-mini-links">研究主題　　證據與方法　　研究檔案</span><a href={BASE + 'search/'} aria-label="開啟正式全文搜尋">搜尋 ↗</a></div>
      <div class="atlas-art-container"><SceneArt variant={concept.slug} instance="home"/></div>
      <div class="atlas-hero-copy">
        <p class="atlas-overline">THE UNKNOWN, ENGINEERED.</p>
        <h2>從未知，<br/>到可追索的證據。</h2>
        <p>{concept.lead}</p>
        <div class="atlas-hero-links"><a class="atlas-cta" href={BASE + 'search/'}>進入研究館 <span aria-hidden="true">↗</span></a><a href="#article-scene">觀看閱讀構圖 ↓</a></div>
      </div>
      <div class="atlas-hero-index" aria-label="真實研究領域">
        <span class="atlas-index-title">INDEX / RESEARCH AREAS</span>
        <ol>{sampleDomains.slice(0,3).map((domain,i)=><li><a href={BASE + 'domains/' + encodeURIComponent(domain) + '/'}><span>0{i+1}</span>{displayDomain(domain)}<span aria-hidden="true">↗</span></a></li>)}</ol>
      </div>
      <p class="atlas-scene-caption">{concept.statement}</p>
    </div>
  </section>
  <section class="atlas-presentation" id="article-scene" data-scene="article" aria-label={concept.title + ' 文章原型'}>
    <div class="atlas-frame-top"><span>02 / ARTICLE</span><span>REAL DOCUMENT · TYPOGRAPHY FIRST</span></div>
    <div class="atlas-prototype atlas-prototype-article">
      <div class="atlas-article-backdrop"><SceneArt variant={concept.slug} instance="article"/></div>
      <div class="atlas-document-layout">
        <div class="atlas-document-body">
          <p class="atlas-overline">THE ARCHIVE / DOCUMENT 001</p>
          <p class="atlas-doc-domain">{displayDomain(doc.group)}</p>
          <h2>{doc.publicTitle}</h2>
          <p class="atlas-doc-source">來源：{doc.file} <span>·</span> 最後修訂：{doc.date}</p>
          <div class="atlas-doc-divider"></div>
          <p class="atlas-doc-para">{doc.summary}</p>
          <a class="atlas-cta" href={doc.href}>閱讀完整原文 <span aria-hidden="true">↗</span></a>
        </div>
        <aside class="atlas-doc-aside"><span class="atlas-overline">CATALOGUE / 目錄預覽</span><ol>{articleHeadings.map(heading=><li>{heading}</li>)}</ol><p>以上為技術文章的章節示例；可到完整閱讀頁檢視目錄與來源。</p></aside>
      </div>
    </div>
  </section>
  <section class="atlas-presentation" id="search-scene" data-scene="search" aria-label={concept.title + ' 搜尋原型'}>
    <div class="atlas-frame-top"><span>03 / SEARCH</span><span>REAL SOURCE INDEX · LIVE SEARCH DEMONSTRATION</span></div>
    <div class="atlas-prototype atlas-prototype-search">
      <div class="atlas-search-art"><SceneArt variant={concept.slug} instance="search"/></div>
      <div class="atlas-search-inner">
        <p class="atlas-overline">DISCOVER THE ARCHIVE</p>
        <h2>探索研究</h2>
        <p class="atlas-search-sub">共 {docs.length} 份原始文件，依領域與來源建立索引。</p>
        <a class="atlas-search-launch" href={BASE + 'search/'}><span aria-hidden="true">⌕</span><span>開啟正式全文搜尋</span><span aria-hidden="true">↗</span></a>
        <div class="atlas-pills">{sampleDomains.map(d=><a href={BASE + 'domains/' + encodeURIComponent(d) + '/'}>{displayDomain(d)} <small>{domainDocs(d).length}</small></a>)}</div>
        <ol class="atlas-results">
          {sampleDocs.map((d,i)=><li><a href={d.href}><span class="atlas-result-num">0{i+1}</span><span>{d.publicTitle}<small>{displayDomain(d.group)}</small></span><span aria-hidden="true">↗</span></a></li>)}
        </ol>
      </div>
    </div>
  </section>
  <section class="atlas-case-outro">
    <span>VISUAL PRINCIPLE / {concept.code}</span><p>{concept.statement}</p>
    <div class="atlas-case-next"><a href={BASE + 'atlas/'}>返回三案總覽 ↑</a><a href={BASE + 'atlas/' + concepts[(concepts.findIndex(c=>c.slug===concept.slug)+1)%3].slug + '/'}>檢視下一案 →</a></div>
  </section>
</div>
</Atlas>