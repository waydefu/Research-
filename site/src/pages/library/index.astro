---
import Base from '../../layouts/Base.astro';
import {allDocs,BASE,domains,domainDocs,displayDomain} from '../../lib/catalog.mjs';
import {topicsFor,tagsFor} from '../../lib/research-metadata.mjs';
const docs=allDocs();
const topics=topicsFor(docs),tags=tagsFor(docs);
const counts=new Map(topics.map(topic=>[topic,docs.filter(d=>d.topic===topic).length]));
---
<Base title="研究典藏｜主題與分類">
  <section class="intro archive-intro">
    <p class="eyebrow">THE OBSERVATORY / RESEARCH LIBRARY</p>
    <h1>研究，不只是收藏答案。<br/><em>而是追蹤它如何成立。</em></h1>
    <p class="intro-sub">從研究領域、細分主題或技術標籤開始。每份研究都有完整原文、來源脈絡；經人工審查的文章另提供白話導讀與作者示範。</p>
    <div class="intro-actions">
      <a class="primary-link" href={BASE + 'search/'}>全文搜尋所有研究 <span aria-hidden="true">↗</span></a>
      <a href="#all-research">依細分類尋找 ↓</a>
    </div>
    <div class="index-stat"><strong>{docs.length}</strong><span>份完整研究；加入 Markdown 即更新索引</span></div>
  </section>
  <section class="library" id="library">
    <header class="section-heading">
      <p class="eyebrow">01 / AREAS</p>
      <h2>先選研究領域</h2>
      <p>主分類依原始研究目錄建立，不用猜測分類網址。</p>
    </header>
    <ol class="domain-list">
      {domains().map((domain,i)=><li><a href={BASE + 'domains/' + encodeURIComponent(domain) + '/'}>
        <span class="domain-num">{String(i+1).padStart(2,'0')}</span>
        <span class="domain-name">{displayDomain(domain)}</span>
        <span class="domain-count">{domainDocs(domain).length} 篇</span>
        <span class="domain-arrow" aria-hidden="true">↗</span>
      </a></li>)}
    </ol>
  </section>
  <section class="library library-topics">
    <header class="section-heading"><p class="eyebrow">02 / TOPICS</p><h2>細分主題</h2>
      <p>主題依標題與文件路徑分配；少數已由編輯校正。遇到未匹配的研究，會歸入「跨領域研究」，不冒稱已完成人工分類。</p>
    </header>
    <nav class="topic-index" aria-label="細分主題快速入口">
      {topics.map(t=><a href={'#all-research'} data-topic-jump={t}>{t}<span>{counts.get(t)}</span></a>)}
    </nav>
  </section>
  <section class="recent archive-index" id="all-research">
    <div class="section-heading"><p class="eyebrow">03 / INDEX</p><h2>全部研究</h2>
      <p>可組合關鍵字、領域、主題和標籤篩選；關閉 JavaScript 時仍能閱讀下方完整清單。</p></div>
    <form id="library-filters" role="search" class="library-filters" autocomplete="off">
      <label>搜尋標題或導讀<input id="library-keyword" type="search" placeholder="例如：海洋、GPU、Agent、索引"/></label>
      <label>研究領域<select id="library-domain"><option value="">全部領域</option>{domains().map(d=><option value={d}>{displayDomain(d)}</option>)}</select></label>
      <label>細分主題<select id="library-topic"><option value="">全部主題</option>{topics.map(t=><option value={t}>{t}（{counts.get(t)}）</option>)}</select></label>
      <label>技術標籤<select id="library-tag"><option value="">全部技術</option>{tags.map(t=><option value={t}>{t}</option>)}</select></label>
      <button id="library-clear" type="reset" class="filter-reset">清除篩選</button>
    </form>
    <p id="library-result-count" role="status" aria-live="polite">顯示 {docs.length} 份研究</p>
    <ol class="document-list research-results" id="library-results">
      {docs.map((d,i)=><li data-domain={d.group} data-topic={d.topic} data-tags={d.tags.join('|')} data-search={(d.publicTitle+' '+d.title+' '+d.summary+' '+d.tags.join(' ')).toLocaleLowerCase('zh-Hant')}>
        <a href={d.href}>
          <span class="research-item-index">{String(i+1).padStart(3,'0')}</span>
          <span class="research-item-main">
            <strong>{d.publicTitle}</strong><span>{d.summary}</span>
            <small>{displayDomain(d.group)} <span aria-hidden="true">·</span> {d.topic} <span aria-hidden="true">·</span> {d.kind}</small>
          </span>
          <span class="research-item-arrow" aria-hidden="true">↗</span>
        </a>
      </li>)}
    </ol>
    <p id="library-empty" hidden>目前沒有相符的研究。試著移除一個條件或改用全文搜尋。</p>
  </section>
  <script is:inline>
    const form=document.getElementById('library-filters');
    const keyword=document.getElementById('library-keyword');
    const domain=document.getElementById('library-domain');
    const topic=document.getElementById('library-topic');
    const tag=document.getElementById('library-tag');
    const entries=[...document.querySelectorAll('#library-results li')];
    const count=document.getElementById('library-result-count');
    const empty=document.getElementById('library-empty');
    const update=()=>{
      const q=keyword.value.trim().toLocaleLowerCase('zh-Hant');
      let visible=0;
      for(const el of entries){
        const match=(!q||el.dataset.search.includes(q)) &&
          (!domain.value||el.dataset.domain===domain.value) &&
          (!topic.value||el.dataset.topic===topic.value) &&
          (!tag.value||el.dataset.tags.split('|').includes(tag.value));
        el.hidden=!match;if(match)visible++;
      }
      count.textContent='顯示 '+visible+' / '+entries.length+' 份研究';
      empty.hidden=visible!==0;
    };
    form.addEventListener('input',update);
    form.addEventListener('change',update);
    form.addEventListener('reset',()=>requestAnimationFrame(update));
    for(const link of document.querySelectorAll('[data-topic-jump]')){
      link.addEventListener('click',()=>{topic.value=link.dataset.topicJump;update()});
    }
    const params=new URLSearchParams(location.search);
    if(params.has('topic')&&[...topic.options].some(o=>o.value===params.get('topic'))) topic.value=params.get('topic');
    if(params.has('q'))keyword.value=params.get('q');
    update();
  </script>
</Base>
