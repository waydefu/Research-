---
const { variant = 'concept-a', instance = 'hero' } = Astro.props;
const id = variant + '-' + instance;
const cx = variant === 'concept-b' ? 1010 : 700;
const scale = variant === 'concept-c' ? 0.64 : variant === 'concept-b' ? 0.95 : 1.15;
const archCenters = variant === 'concept-c' ? [80,280,1120,1320] : [110,320,1080,1290];
const stars = Array.from({ length: 75 }, (_, i) => ({
  x: (i * 167 + 47) % 1400,
  y: (i * 97 + 23) % 475,
  size: i % 13 === 0 ? 2.1 : (i % 5 === 0 ? 1.15 : 0.55)
}));
---
<svg class="sanctum-art" viewBox="0 0 1400 820" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={'sky-'+id} cx="50%" cy="33%" r="83%">
      <stop offset="0%" stop-color="#253957" />
      <stop offset="52%" stop-color="#101c2d" />
      <stop offset="100%" stop-color="#06090f" />
    </radialGradient>
    <radialGradient id={'halo-'+id}>
      <stop offset="0%" stop-color="#e3bc7a" stop-opacity=".48" />
      <stop offset="32%" stop-color="#aa8141" stop-opacity=".12" />
      <stop offset="100%" stop-color="#ad8543" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={'gold-'+id} x1="0" x2="1" y1="0" y2="1">
      <stop offset="0" stop-color="#4d3726"/>
      <stop offset=".28" stop-color="#e8c991"/>
      <stop offset=".55" stop-color="#a9814b"/>
      <stop offset=".78" stop-color="#f1daa8"/>
      <stop offset="1" stop-color="#60442e"/>
    </linearGradient>
    <linearGradient id={'column-'+id} x1="0" x2="1">
      <stop offset="0" stop-color="#080c12"/>
      <stop offset=".25" stop-color="#283242"/>
      <stop offset=".45" stop-color="#4b4b4e"/>
      <stop offset=".75" stop-color="#192330"/>
      <stop offset="1" stop-color="#090c12"/>
    </linearGradient>
    <linearGradient id={'floor-'+id} x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="#1c2b37"/>
      <stop offset="100%" stop-color="#060a10"/>
    </linearGradient>
    <radialGradient id={'blue-'+id}>
      <stop offset="0%" stop-color="#a3cce4" stop-opacity=".85"/>
      <stop offset="23%" stop-color="#629abb" stop-opacity=".3"/>
      <stop offset="100%" stop-color="#629abb" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="1400" height="820" fill={'url(#sky-'+id+')'}/>
  <ellipse cx="705" cy="140" rx="480" ry="315" fill={'url(#blue-'+id+')'} opacity=".31"/>
  <g fill="#d7e8f1" opacity=".5">
    {stars.map((s,i)=><circle cx={s.x} cy={s.y} r={s.size} opacity={i%7===0 ? .85 : .38}/>)}
  </g>
  <g fill="none" stroke="#9f805b" stroke-opacity=".32" stroke-width="2">
    <path d="M110 490V155Q700 -278 1290 155V490"/>
    <path d="M170 490V172Q700 -194 1230 172V490"/>
    <path d="M245 490V194Q700 -86 1155 194V490"/>
    <path d="M317 490V218Q700 16 1083 218V490"/>
    <path d="M398 490V246Q700 115 1002 246V490"/>
  </g>
  <g fill="none" stroke="#d0ae73" stroke-width="1" stroke-opacity=".45">
    <ellipse cx="700" cy="64" rx="444" ry="113"/>
    <ellipse cx="700" cy="64" rx="383" ry="93"/>
    <ellipse cx="700" cy="64" rx="270" ry="66"/>
    {Array.from({length:19},(_,i)=> {
      const angle=(i*18.9)*Math.PI/180;
      return <path d={'M'+(700+383*Math.cos(angle))+' '+(64+93*Math.sin(angle))+'L'+(700+444*Math.cos(angle))+' '+(64+113*Math.sin(angle))} />;
    })}
  </g>
  <g opacity=".95">
    {archCenters.map((x,i)=>
      <g>
        <rect x={x-38} y="185" width="76" height="370" fill={'url(#column-'+id+')'}/>
        <rect x={x-51} y="166" width="102" height="23" fill="#15171d" stroke="#96774e" stroke-width="2"/>
        <rect x={x-48} y="508" width="96" height="50" fill="#111923" stroke="#96774e" stroke-opacity=".6"/>
        <path d={'M'+(x-30)+' 200V495 M'+(x+30)+' 200V495'} stroke="#8d774f" stroke-width="2" opacity=".46"/>
        <path d={'M'+(x-43)+' 174H'+(x+43)} stroke="#d1ae6e" stroke-width="3" opacity=".8"/>
        <circle cx={x} cy="181" r="4" fill="#e0be84"/>
      </g>
    )}
  </g>
  <path d="M0 560L1400 560V820H0Z" fill={'url(#floor-'+id+')'}/>
  <g fill="none" stroke="#a78b60" stroke-opacity=".27" stroke-width="1.6">
    <path d="M0 560L1400 560 M0 608H1400 M0 668H1400 M0 756H1400"/>
    {Array.from({length:15},(_,i)=><path d={'M700 528L'+(i*135-250)+' 820'}/>)}
  </g>
  <g fill="none" stroke="#d4b173" stroke-opacity=".4">
    <path d="M0 550H1400"/>
    <path d="M0 560H1400"/>
    <path d="M70 546V575M1330 546V575"/>
  </g>
  <g transform={'translate('+cx+' 375) scale('+scale+')'}>
    <circle r="265" fill={'url(#halo-'+id+')'}/>
    <g fill="none" stroke={'url(#gold-'+id+')'} stroke-width="9">
      <ellipse rx="220" ry="88" transform="rotate(-31)"/>
      <ellipse rx="216" ry="97" transform="rotate(54)"/>
      <ellipse rx="185" ry="184" transform="rotate(-12)"/>
      <ellipse rx="232" ry="60" transform="rotate(18)"/>
    </g>
    <g fill="none" stroke="#d3b682" stroke-width="2.5" opacity=".9">
      <circle r="169"/>
      <circle r="151" stroke-dasharray="2 11"/>
      <ellipse rx="150" ry="27"/>
      <ellipse rx="32" ry="150"/>
      <path d="M-170 0H170M0 -172V172"/>
    </g>
    <circle r="73" fill={'url(#halo-'+id+')'}/>
    <circle r="45" fill="#b2925e" stroke="#f0d4a2" stroke-width="3"/>
    <circle r="36" fill="#f2d7a9"/>
    <circle r="28" fill="#fff2cf"/>
    <circle r="17" fill="#fff8e8"/>
    <g fill="#deb97b">
      <circle cx="-170" cy="-127" r="11"/>
      <circle cx="182" cy="-98" r="8"/>
      <circle cx="83" cy="191" r="7"/>
    </g>
    <path d="M-23 183V252H23V183Z" fill="#282529" stroke="#c7a46b" stroke-width="3"/>
    <path d="M-77 254H77V272H-77Z" fill="#151a20" stroke="#c6a36e" stroke-width="3"/>
  </g>
  <g fill="#121923" stroke="#b79661" stroke-opacity=".65" stroke-width="2">
    <path d="M460 625H940L990 646H410Z"/>
    <path d="M410 646H990L1042 671H358Z"/>
    <path d="M358 671H1042L1105 705H295Z"/>
    <path d="M295 705H1105L1184 744H216Z"/>
  </g>
  <g opacity=".48" fill="none" stroke="#6ea8d6" stroke-width="2">
    <ellipse cx="700" cy="660" rx="215" ry="29"/>
    <path d="M488 660Q700 710 912 660"/>
    <path d="M527 654Q700 685 870 655"/>
  </g>
  {variant === 'concept-c' && <g>
    <path d="M0 0H170L385 820H0Z M1400 0H1230L1015 820H1400Z" fill="#090d13" opacity=".93"/>
    <path d="M170 0L385 820M1230 0L1015 820" stroke="#b59461" stroke-width="5" opacity=".7"/>
    <path d="M22 0L250 820M1378 0L1150 820" stroke="#493f39" stroke-width="6"/>
    <g fill="none" stroke="#d3b174" opacity=".4" stroke-width="2">
      <path d="M50 550Q700 -5 1350 550"/>
      <path d="M90 525Q700 60 1310 525"/>
    </g>
  </g>}
  <rect x="0" y="0" width="1400" height="820" fill="none" stroke="#c8a56c" stroke-opacity=".26" stroke-width="7"/>
</svg>