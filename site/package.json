    "predev": "npm run preflight"
  },
  "dependencies": {
    "astro": "^6.0.0",
    "pagefind": "^1.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^6.0.0"
  }
}
